# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/tambola

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_EXPIRY=15m
REFRESH_SECRET=change-me-in-production
REFRESH_EXPIRY=7d

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to use Ethereal (fake SMTP) in development.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Tambola <noreply@example.com>

# Frontend URL used in email verification / password-reset links
FRONTEND_URL=http://localhost:5173

# ── OpenTelemetry / Dynatrace ─────────────────────────────────────────────────
OTEL_SERVICE_NAME=tambola-backend
# DT_OTLP_ENDPOINT=https://<env-id>.live.dynatrace.com/api/v2/otlp
# DT_API_TOKEN=<dynatrace-api-token>

# ── Sentry ────────────────────────────────────────────────────────────────────
# Obtain your DSN from: https://sentry.io → Settings → Projects → <project> → Client Keys
# Leave unset (or empty) to disable Sentry error reporting.
SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# ── Better Stack (optional log ingestion) ────────────────────────────────────
# BETTER_STACK_API_TOKEN=your-token-here
